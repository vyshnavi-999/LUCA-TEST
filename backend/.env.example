# Copy this to ".env" and fill in real values. Never commit the real .env.

# --- AWS region (used by S3) ---
AWS_REGION=ap-south-1

# --- RDS Postgres (database) ---
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR-RDS-ENDPOINT:5432/voice

# --- S3 (audio) ---
S3_BUCKET=your-s3-bucket-name 
# On EC2 use an attached IAM ROLE (no keys here). LOCAL testing only:
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# --- ASR ---
SARVAM_API_KEY=your-sarvam-api-key

# Frontend origin for CORS (local testing):
ALLOWED_ORIGIN=http://localhost:8080

# Usage limit: max COMPLETED recordings per user per rolling 24h. 0 = unlimited (Phase 1).
DAILY_LIMIT=0

# --- Admin ---
ADMIN_TOKEN=your-admin-token

# --- LLM (Phase 2+) ---
LLM_ENDPOINT=your-llm-endpoint
LLM_MODEL=your-llm-model
LLM_MODEL_VERSION=your-llm-model-version

# --- TTS (Phase 2+) ---
SARVAM_TTS_API_KEY=your-sarvam-tts-api-key
TTS_MODEL=your-tts-model
TTS_SAMPLE_RATE=22050
TTS_SPEAKER=your-tts-speaker
